alphabet = {h, i}

machine clear_tape = {
  states = {s, c1, c2, c3, e}
  init_state = {s}
  halting_states = {e}
  function = {
    s _ -> c1 w h;
    s h -> e g right;
    s i -> e g right;
    c1 h -> c2 g right;
    c1 i -> e g right;
    c1 _ -> e g right;
    c2 i -> c1 w _;
    c2 h -> e g right;
    c2 _ -> c3 g left;
    c3 h -> e w _;
    c3 i -> e g right;
    c3 _ -> e g right;
  }
}

machine print_hi = {
  states = {s, q, p, e}
  init_state = {s}
  halting_states = {e}
  function = {
    s _ -> q w h;
    s h -> e g right;
    s i -> e g right;
    q _ -> p g right;
    q h -> e g right;
    q i -> e g right;
    p _ -> e w i;
    p h -> e g right;
    p i -> e g right;
  }
}

machine start = {
  states = {s, q, e}
  init_state = {s}
  halting_states = {e}
  function = {
    s _ -> q c clear_tape;
    s h -> e g right;
    s i -> e g right;
    q _ -> e c print_hi;
    q h -> e g right;
    q i -> e g right;
  }
}